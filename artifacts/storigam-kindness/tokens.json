{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F7F4ED" },
      "foreground": { "$value": "#191727" },
      "border": { "$value": "#D6D0E1" },
      "card": { "$value": "#FCFBF8" },
      "cardForeground": { "$value": "#191727" },
      "popover": { "$value": "#FFFDFC" },
      "popoverForeground": { "$value": "#191727" },
      "primary": {
        "$value": "#5F3BBA",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#EAE5F2" },
      "secondaryForeground": { "$value": "#191727" },
      "muted": { "$value": "#ECE8F3" },
      "mutedForeground": { "$value": "#59566C" },
      "accent": { "$value": "#F4A8C8" },
      "accentForeground": { "$value": "#331A2A" },
      "destructive": { "$value": "#B42222" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D9D3E6" },
      "ring": { "$value": "#6B4BD0" },
      "chart1": { "$value": "#9B78FF" },
      "chart2": { "$value": "#F4A8C8" },
      "chart3": { "$value": "#E8B830" },
      "chart4": { "$value": "#6A9BCB" },
      "chart5": { "$value": "#68B8A4" },
      "sidebar": { "$value": "#F2EEE8" },
      "sidebarForeground": { "$value": "#191727" },
      "sidebarBorder": { "$value": "#D6CDE8" },
      "sidebarPrimary": { "$value": "#5F3BBA" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#E9E2F4" },
      "sidebarAccentForeground": { "$value": "#2A2140" },
      "sidebarRing": { "$value": "#6B4BD0" }
    },
    "dark": {
      "background": { "$value": "#0A0818" },
      "foreground": { "$value": "#EDE8FF" },
      "border": { "$value": "#342C49" },
      "card": { "$value": "#130F28" },
      "cardForeground": { "$value": "#EDE8FF" },
      "popover": { "$value": "#17122F" },
      "popoverForeground": { "$value": "#EDE8FF" },
      "primary": { "$value": "#9B78FF" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#1C1838" },
      "secondaryForeground": { "$value": "#EDE8FF" },
      "muted": { "$value": "#251F3A" },
      "mutedForeground": { "$value": "#C8B8E8" },
      "accent": { "$value": "#F4A8C8" },
      "accentForeground": { "$value": "#301726" },
      "destructive": { "$value": "#E05568" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#39304E" },
      "ring": { "$value": "#B8A1FF" },
      "chart1": { "$value": "#9B78FF" },
      "chart2": { "$value": "#F4A8C8" },
      "chart3": { "$value": "#E8B830" },
      "chart4": { "$value": "#B8D4F0" },
      "chart5": { "$value": "#79CBB1" },
      "sidebar": { "$value": "#090718" },
      "sidebarForeground": { "$value": "#EDE8FF" },
      "sidebarBorder": { "$value": "#332A47" },
      "sidebarPrimary": { "$value": "#9B78FF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#1C1838" },
      "sidebarAccentForeground": { "$value": "#EDE8FF" },
      "sidebarRing": { "$value": "#B8A1FF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Satoshi", "Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.25rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
