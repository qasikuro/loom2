{
  "expo": {
    "name": "Storigam",
    "slug": "sky-journal",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/storigam-icon.png",
    "scheme": [
      "storigam",
      "sky-journal"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.storigam.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.storigam.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/storigam-adaptive-icon.png",
        "backgroundColor": "#030014"
      }
    },
    "web": {
      "favicon": "./assets/images/storigam-favicon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/storigam-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#030014"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Storigam to access your photos to add images to your logs."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Storigam to save gallery photos to your library.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/storigam-notification.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-audio",
      "expo-video",
      "expo-sharing"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/95bfb37d-2b50-4ab2-abea-799b09a08144",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "95bfb37d-2b50-4ab2-abea-799b09a08144"
      }
    }
  }
}
