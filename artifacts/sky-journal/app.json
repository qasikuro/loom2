{
  "expo": {
    "name": "Ximo",
    "slug": "sky-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ximo_icon.png",
    "scheme": "sky-journal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/ximo_splash.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#D7D8FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gamejo.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gamejo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ximo_adaptive_icon.png",
        "backgroundColor": "#F0EAFE"
      }
    },
    "web": {
      "favicon": "./assets/images/ximo_icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ximo to access your photos to add images to your logs."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ximo_icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "exclude": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "95bfb37d-2b50-4ab2-abea-799b09a08144"
      }
    }
  }
}
